m={[1, 2]: "abc", true: 43}
log("before changes", m)
m[[1, 2]] *= 3 // -> "abcabcabc"
Assert("m[[1, 2]] should be 'abcabcabc'", m[[1, 2]] == "abcabcabc")

m[[1, 2]] = "a"
m[[1, 2]] += "b"
Assert("m[[1, 2]] should be 'ab'", m[[1, 2]] == "ab")

x = {"a":{"b":{"c":1}}}
log("before changes x = {a:{b:{c:1}}}", x)
x.a.b.c |= 12
Assert("x.a.b.c should be 13", x.a.b.c==13)

x["a"]["b"]["c"] += 3
Assert("x[a][b][c] should be 16", x["a"]["b"]["c"] == 16)

del(x)
m = [1, 2, 3, 4]
log("before changes m is", m)
m += 5
Assert("m should be [1, 2, 3, 4, 5]", m == [1, 2, 3, 4, 5])
m[4] += 5
Assert("m[4] should be 10", m[4] == 10)

del(m)

// bug #384 double eval in print

i := 1
func foo() {
	log("foo called with i=", i)
	++i
}
print(foo())
Assert("i should be 2 after foo()", i == 2)

// Test error messages for index assignment to unexpected types
// Case 1: Direct variable assignment (identifier not empty)
intVar := 42
IsErr("direct assignment to non-indexable shows variable name", intVar[0] = 5, "index assignment to intVar of unexpected type")

// Case 2: Nested expression assignment (identifier empty)
func getInt() { 42 }
IsErr("nested assignment to non-indexable shows generic message", getInt()[0] = 5, "index assignment to object of unexpected type")

// Failed compound assignments report the error without replacing their target.
// IsErr catches each failure so the following assertions reuse the same state.
cfCompoundX=12
IsErr("identifier compound division", cfCompoundX/=0, "division by zero"); Assert("identifier unchanged after compound error", cfCompoundX==12)
NoErr("identifier compound update", cfCompoundX+=1, "13"); Assert("identifier compound update stored", cfCompoundX==13)
cfCompoundArray=[12]
IsErr("array compound division", cfCompoundArray[0]/=0, "division by zero"); Assert("array unchanged after compound error", cfCompoundArray==[12])
NoErr("array compound update", cfCompoundArray[0]+=1, "13"); Assert("array compound update stored", cfCompoundArray==[13])
cfCompoundMap={"a":1}
IsErr("map compound division", cfCompoundMap.a/=0, "division by zero"); Assert("map unchanged after compound error", cfCompoundMap.a==1)
NoErr("map compound update", cfCompoundMap.a+=1, "2"); Assert("map compound update stored", cfCompoundMap.a==2)
cfCompoundBigArray=[0,1,2,3,4,5,6,7,12]
IsErr("big array compound division", cfCompoundBigArray[8]/=0, "division by zero"); Assert("big array unchanged after compound error", cfCompoundBigArray==[0,1,2,3,4,5,6,7,12])
NoErr("big array compound update", cfCompoundBigArray[8]+=1, "13"); Assert("big array compound update stored", cfCompoundBigArray[8]==13)
cfCompoundBigMap={"k0":0,"k1":1,"k2":2,"k3":3,"k4":4}
IsErr("big map compound division", cfCompoundBigMap.k4/=0, "division by zero"); Assert("big map unchanged after compound error", cfCompoundBigMap.k4==4)
NoErr("big map compound update", cfCompoundBigMap.k4+=1, "5"); Assert("big map compound update stored", cfCompoundBigMap.k4==5)
IsErr("compound assignment to undefined identifier", cfCompoundUndefined+=1, "identifier not found: cfCompoundUndefined")
IsErr("failed compound assignment leaves identifier undefined", cfCompoundUndefined, "^identifier not found: cfCompoundUndefined$")
cfCompoundCaught=12
Assert("catch reports compound arithmetic error", catch(cfCompoundCaught/=0).err); Assert("caught compound error leaves target unchanged", cfCompoundCaught==12)
cfCompoundCaughtUndefinedResult=catch(cfCompoundCaughtUndefined+=1); Assert("catch reports undefined compound error", cfCompoundCaughtUndefinedResult.err); IsErr("caught compound error leaves identifier undefined", cfCompoundCaughtUndefined, "^identifier not found: cfCompoundCaughtUndefined$")
cfCompoundMissingMap={}
IsErr("compound assignment to missing map key", cfCompoundMissingMap.b+=1, "no PLUS on left=nil right=1"); Assert("failed compound assignment does not create map key", len(cfCompoundMissingMap)==0)
cfCompoundCaughtMapResult=catch(cfCompoundMissingMap.c+=1); Assert("catch reports missing-map compound error", cfCompoundCaughtMapResult.err); Assert("caught compound error does not create map key", len(cfCompoundMissingMap)==0)
cfCompoundWide=9223372036854775807
NoErr("compound update promotes to BigInt", cfCompoundWide+=1, "9223372036854775808"); Assert("compound BigInt update stored", type(cfCompoundWide)=="BIGINT" && cfCompoundWide==9223372036854775808)
cfCompoundDiagnosticArray=[12]
IsErr("out-of-bounds positive compound assignment", cfCompoundDiagnosticArray[5]+=1, "index assignment out of bounds: 5")
IsErr("out-of-bounds negative compound assignment", cfCompoundDiagnosticArray[-3]+=1, "index assignment out of bounds: -3")
cfCompoundNotArray=1
IsErr("compound assignment to non-indexable variable", cfCompoundNotArray[0]+=1, "index assignment to cfCompoundNotArray of unexpected type INTEGER .1.")
IsErr("compound assignment with non-integer array index", cfCompoundDiagnosticArray["k"]+=1, "index assignment to array with non integer index")

dur := time.duration("1w1d3h")
expected := (7+1)*86400 + 3*3600.0 // need float for == to work
log("duration 1w1d3h in seconds is", dur, "expecting", expected)
Assert("time.duration(\"1w1d3h\")", dur == expected)

arr := []
arr += 1
arr += true
arr += "test"
NoErr("array += 2.1", arr += 2.1, "[1, true, \"test\", 2.1]")
// Test precedence bug: operators at same precedence level should be left-associative
// but parentheses should be preserved when needed
num := 123
index := 2
digit1 := num % 10 << (index * 4) // should evaluate to 768: 3 << 8
digit2 := num % 10 << index * 4   // should evaluate to 48: (3 << 2) * 4
Assert("num % 10 << (index * 4) with parens", digit1 == 768)
Assert("num % 10 << index * 4 without parens", digit2 == 48)
